<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jelly.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    prefHeight="540.0"
                    prefWidth="400.0"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="60.0">
            <content>
                <VBox fx:id="messageArea" spacing="10.0" />
            </content>
        </ScrollPane>

        <HBox layoutX="10.0"
              layoutY="550.0"
              prefWidth="380.0"
              spacing="10.0">
            <children>
                <TextField fx:id="inputField"
                           onAction="#handleInput"
                           prefWidth="315.0" />
                <Button onAction="#handleInput"
                        prefWidth="55.0"
                        text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
